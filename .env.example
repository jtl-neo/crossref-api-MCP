# Crossref MCP server configuration. Copy to .env and fill in.

# Your email — joins Crossref's polite pool (faster, more reliable). Recommended.
CROSSREF_MAILTO=you@example.com

# Optional Crossref Plus API token (sent as a header alongside mailto).
# CROSSREF_PLUS_TOKEN=

# Optional HTTP auth. If set, HTTP clients must send a matching X-API-Key
# header. Leave empty to disable (default). /health is always exempt.
# MCP_API_KEY=

# Transport: "http" (container default) or "stdio".
MCP_TRANSPORT=http

# Crossref API base URL (rarely changed).
CROSSREF_BASE_URL=https://api.crossref.org

# Per-request timeout in seconds.
CROSSREF_TIMEOUT=30

# Log level: DEBUG | INFO | WARNING | ERROR (logs go to stderr).
LOG_LEVEL=INFO

# --- Optional: Redis cache + cross-replica rate limiting (M9) ---
# Unset = no cache, in-memory rate limiting (single-process default).
# REDIS_URL=redis://redis:6379/0
# CACHE_TTL=86400
# CACHE_NAMESPACE=crossref-mcp:v1
# RATELIMIT_BACKEND=in-memory   # set to "redis" for multi-replica (needs REDIS_URL)

