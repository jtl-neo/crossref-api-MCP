{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jtl-neo/crossref-mcp",
  "description": "MCP server wrapping the Crossref REST API for scholarly metadata.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/jtl-neo/crossref-api-MCP",
    "source": "github"
  },
  "websiteUrl": "https://github.com/jtl-neo/crossref-api-MCP",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "crossref-mcp",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "CROSSREF_MAILTO",
          "description": "Email for Crossref's polite pool (recommended).",
          "isRequired": false
        },
        {
          "name": "CROSSREF_PLUS_TOKEN",
          "description": "Optional Crossref Plus API token.",
          "isSecret": true,
          "isRequired": false
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "docker.io/heyinnaneo/crossref-mcp:0.1.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "CROSSREF_MAILTO",
          "description": "Email for Crossref's polite pool (recommended).",
          "isRequired": false
        },
        {
          "name": "CROSSREF_PLUS_TOKEN",
          "description": "Optional Crossref Plus API token.",
          "isSecret": true,
          "isRequired": false
        },
        {
          "name": "MCP_API_KEY",
          "description": "Optional X-API-Key for HTTP transport.",
          "isSecret": true,
          "isRequired": false
        }
      ]
    }
  ]
}
